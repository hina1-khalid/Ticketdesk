PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ticketdesk
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Optional: Redis => caching + BullMQ background jobs (without it, in-memory + inline jobs)
REDIS_URL=
# Optional: email (without it, emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TicketDesk <support@example.com>"
# Optional: Python AI service (classification). Without it, built-in rules (English + Roman Urdu) are used
AI_SERVICE_URL=
# Optional: LLM reply drafts
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optional integrations
SLACK_WEBHOOK_URL=
SENTRY_DSN=
INBOUND_EMAIL_SECRET=change-me

# Optional: read a support inbox (IMAP). Gmail: enable 2-Step Verification and create an App Password
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_ORG_SLUG=demo
# Optional: WhatsApp via Twilio (sandbox works for demos)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_ORG_SLUG=demo
# Public URL of this API (needed to verify Twilio signatures)
PUBLIC_URL=http://localhost:5000
